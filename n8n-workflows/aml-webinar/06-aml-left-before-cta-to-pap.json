{
  "name": "AML Webinar Left Before CTA (120mins) to PAP",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aml-webinar-left-early",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Aevent Left Early Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "aml-left-early"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://rest.gohighlevel.com/v1/contacts/lookup?email={{ encodeURIComponent($json.email) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "ghl-lookup-contact",
      "name": "Lookup GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GHL-API-Key",
          "name": "GHL API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://rest.gohighlevel.com/v1/contacts/{{ $('Lookup GHL Contact').json.contacts[0].id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tags\": [\"AML-Webinar-Left-Before-CTA\", \"AML-Stealth\", \"AML-Nurture-Needed\"],\n  \"customField\": {\n    \"webinar_left_at\": \"{{ $now.toISO() }}\",\n    \"watch_time_minutes\": \"{{ $json.watch_time || $json.watchTime || '<120' }}\",\n    \"webinar_dropoff_zone\": \"Before-CTA\"\n  }\n}",
        "options": {}
      },
      "id": "ghl-update-contact",
      "name": "Update GHL Contact - Left Early Tag",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GHL-API-Key",
          "name": "GHL API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "contact-exists",
              "leftValue": "={{ $json.contacts?.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-contact-exists",
      "name": "Contact Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [570, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rest.gohighlevel.com/v1/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $('Aevent Left Early Webhook').json.email }}\",\n  \"firstName\": \"{{ $('Aevent Left Early Webhook').json.first_name || '' }}\",\n  \"lastName\": \"{{ $('Aevent Left Early Webhook').json.last_name || '' }}\",\n  \"tags\": [\"AML-Webinar-Left-Before-CTA\", \"AML-Stealth\", \"AML-Nurture-Needed\"],\n  \"source\": \"Aevent Webinar\",\n  \"customField\": {\n    \"webinar_left_at\": \"{{ $now.toISO() }}\",\n    \"webinar_dropoff_zone\": \"Before-CTA\"\n  }\n}",
        "options": {}
      },
      "id": "ghl-create-new",
      "name": "Create New GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 450],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GHL-API-Key",
          "name": "GHL API Key"
        }
      }
    }
  ],
  "connections": {
    "Aevent Left Early Webhook": {
      "main": [
        [
          {
            "node": "Lookup GHL Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lookup GHL Contact": {
      "main": [
        [
          {
            "node": "Contact Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Contact Exists?": {
      "main": [
        [
          {
            "node": "Update GHL Contact - Left Early Tag",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create New GHL Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "aml-webinar-suite"
  },
  "tags": [
    {
      "name": "AML-Webinar"
    },
    {
      "name": "Aevent"
    },
    {
      "name": "GHL"
    }
  ]
}
