{
  "name": "AML Webinar Registrants to PAP",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aml-webinar-registrant",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Aevent Registration Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "aml-registrant"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rest.gohighlevel.com/v1/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $json.email }}\",\n  \"firstName\": \"{{ $json.first_name || $json.firstName || '' }}\",\n  \"lastName\": \"{{ $json.last_name || $json.lastName || '' }}\",\n  \"phone\": \"{{ $json.phone || '' }}\",\n  \"tags\": [\"AML-Webinar-Registrant\", \"AML-Stealth\"],\n  \"source\": \"Aevent Webinar\",\n  \"customField\": {\n    \"webinar_registered_at\": \"{{ $now.toISO() }}\",\n    \"webinar_name\": \"AML Webinar Stealth\"\n  }\n}",
        "options": {}
      },
      "id": "ghl-create-contact",
      "name": "Create/Update GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GHL-API-Key",
          "name": "GHL API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "email-exists",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-email",
      "name": "Validate Email Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [370, 300]
    },
    {
      "parameters": {},
      "id": "no-action",
      "name": "No Email - Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [500, 450]
    }
  ],
  "connections": {
    "Aevent Registration Webhook": {
      "main": [
        [
          {
            "node": "Validate Email Exists",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Email Exists": {
      "main": [
        [
          {
            "node": "Create/Update GHL Contact",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Email - Skip",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "aml-webinar-suite"
  },
  "tags": [
    {
      "name": "AML-Webinar"
    },
    {
      "name": "Aevent"
    },
    {
      "name": "GHL"
    }
  ]
}
