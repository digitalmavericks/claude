# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Anthropic API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Evolution Settings
DEFAULT_JUDGE_MODEL=claude-sonnet-4-6
DEFAULT_MUTATION_MODEL=claude-sonnet-4-6
MAX_POPULATION_SIZE=100
ELITE_THRESHOLD=0.8

# Self-Play Settings
SELFPLAY_ROUNDS_PER_NIGHT=5
SELFPLAY_JUDGE_MODEL=claude-sonnet-4-6

# Reflection Settings
REFLECTION_LOOKBACK_HOURS=168
REFLECTION_MIN_EVENTS=3

# Paths (adjust for your system)
OPENCLAW_HOME=/Users/echo/.openclaw
EVOLUTION_DIR=/Users/echo/.openclaw/evolution
LOGS_DIR=/Users/echo/.openclaw/logs
SOUL_PROPOSALS_DIR=/Users/echo/.openclaw/.soul_proposals
SKILLS_DIR=/Users/echo/.openclaw/skills
