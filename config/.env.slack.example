# Echo Slack Events API config — copy to ~/.openclaw/.env.slack on the Mac
# chmod 600 ~/.openclaw/.env.slack after creating it.
#
# Required
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me-32-hex

# Optional — only if Echo posts as the workspace user, not the bot
# SLACK_USER_TOKEN=xoxp-replace-me

# Optional overrides
# SLACK_SERVER_PORT=8080
# SLACK_LOG_LEVEL=INFO
